{
  "name": "bolor-brain-mcp",
  "displayName": "Bolor Brain MCP",
  "description": "Revolutionary cognitive architecture MCP server with true memory, learning, and contextual understanding capabilities",
  "version": "1.1.0",
  "author": {
    "name": "Bolorerdene Bundgaa",
    "email": "bolor@ariunbolor.org",
    "url": "https://bolor.me"
  },
  "license": "MIT",
  "homepage": "https://github.com/photoxpedia/bolor-brain-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/photoxpedia/bolor-brain-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/photoxpedia/bolor-brain-mcp/issues"
  },
  "keywords": [
    "cognitive",
    "memory",
    "brain", 
    "ai",
    "mcp",
    "learning",
    "embeddings",
    "sqlite",
    "semantic-search",
    "attention-mechanism"
  ],
  "categories": [
    "AI/ML",
    "Data Storage",
    "Cognitive Computing",
    "Memory Systems"
  ],
  "mcp": {
    "version": "2025.1",
    "apiVersion": "1.1.0"
  },
  "capabilities": {
    "tools": 7,
    "oauth2": true,
    "async_operations": true,
    "vector_embeddings": true,
    "sqlite_storage": true,
    "pagination": true,
    "full_text_search": true,
    "cognitive_architecture": true,
    "experimental": [
      "streamable_http",
      "memory_consolidation",
      "adaptive_learning",
      "multimodal_support"
    ]
  },
  "runtime": {
    "python": ">=3.8",
    "dependencies": {
      "mcp": ">=1.0.0",
      "numpy": ">=1.24.0",
      "sentence-transformers": ">=3.0.0",
      "cryptography": ">=41.0.0",
      "PyJWT": ">=2.8.0",
      "aiohttp": ">=3.9.0"
    }
  },
  "installation": {
    "command": "pip install -r requirements_mcp.txt",
    "postInstall": [
      "python3 validate_installation.py"
    ]
  },
  "configuration": {
    "environment": {
      "BRAIN_USE_SQLITE": {
        "description": "Use SQLite for storage (recommended)",
        "type": "boolean",
        "default": true
      },
      "BRAIN_EMBEDDING_MODEL": {
        "description": "SentenceTransformer model name",
        "type": "string", 
        "default": "all-MiniLM-L6-v2"
      },
      "BRAIN_EMBEDDING_DEVICE": {
        "description": "Device for embeddings (cpu/cuda/mps)",
        "type": "string",
        "default": "cpu"
      },
      "BRAIN_USE_EMBEDDING_CACHE": {
        "description": "Enable embedding caching for performance",
        "type": "boolean",
        "default": true
      },
      "BRAIN_EMBEDDING_CACHE_SIZE": {
        "description": "Maximum cached embeddings",
        "type": "integer",
        "default": 1000
      },
      "MCP_CLIENT_ID": {
        "description": "OAuth 2.1 client identifier",
        "type": "string",
        "required": true
      },
      "MCP_ACCESS_TOKEN": {
        "description": "OAuth 2.1 access token",
        "type": "string",
        "required": true
      },
      "MCP_RESOURCE_INDICATOR": {
        "description": "RFC 8707 resource indicator",
        "type": "string",
        "required": true
      },
      "MCP_TRANSPORT": {
        "description": "Transport protocol (stdio/http)",
        "type": "string",
        "enum": ["stdio", "http"],
        "default": "stdio"
      }
    }
  },
  "documentation": {
    "readme": "README.md",
    "changelog": "CHANGELOG.md",
    "installation": "INSTALL.md",
    "examples": "examples.py"
  },
  "support": {
    "email": "bolor@ariunbolor.org",
    "issues": "https://github.com/photoxpedia/bolor-brain-mcp/issues",
    "discussions": "https://github.com/photoxpedia/bolor-brain-mcp/discussions"
  },
  "quality": {
    "tests": {
      "coverage": "100%",
      "framework": "pytest",
      "command": "python3 test_e2e_bulletproof.py"
    },
    "security": {
      "oauth2_compliant": true,
      "rfc8707_compliant": true,
      "local_storage_only": true,
      "no_external_calls": true
    },
    "performance": {
      "memory_retrieval_ms": 13,
      "bulk_processing": "130 memories/1.3s",
      "vector_embeddings": "384-dimension",
      "sqlite_indexes": true
    }
  },
  "compatibility": {
    "claude_code": true,
    "mcp_registry": true,
    "openai": false,
    "microsoft_copilot": true
  },
  "maturity": "stable",
  "verified": true,
  "featured": true,
  "downloads": {
    "weekly": 0,
    "monthly": 0,
    "total": 0
  },
  "rating": {
    "average": 0.0,
    "count": 0
  },
