{
  "mcpServers": {
    "bolor-brain-mcp": {
      "command": "python3",
      "args": ["brain_mcp_server.py"],
      "cwd": ".",
      "env": {
        "BRAIN_STORAGE_PATH": "./brain_mcp_storage",
        "BRAIN_LOG_LEVEL": "INFO",
        "MCP_CLIENT_ID": "claude-code-client",
        "MCP_ACCESS_TOKEN": "replace-with-production-token",
        "MCP_RESOURCE_INDICATOR": "https://claude.ai/code/brain-mcp",
        "MCP_SECURITY_MODE": "oauth2.1",
        "MCP_REQUIRE_RESOURCE_INDICATOR": "true"
      }
    }
  }
}