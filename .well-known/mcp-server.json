{
  "name": "bolor-brain-mcp",
  "version": "1.1.0",
  "description": "Revolutionary cognitive architecture MCP server with true memory, learning, and contextual understanding",
  "author": {
    "name": "Bolorerdene Bundgaa",
    "email": "bolor@ariunbolor.org",
    "website": "https://bolor.me"
  },
  "license": "MIT",
  "homepage": "https://github.com/photoxpedia/bolor-brain-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/photoxpedia/bolor-brain-mcp.git"
  },
  "capabilities": {
    "oauth2": true,
    "resource_indicators": true,
    "async_operations": true,
    "pagination": true,
    "sqlite_storage": true,
    "vector_embeddings": true,
    "full_text_search": true,
    "cognitive_architecture": true,
    "memory_types": ["working", "episodic", "semantic", "procedural", "emotional"],
    "experimental": {
      "streamable_http": true,
      "memory_consolidation": true,
      "adaptive_learning": true,
      "multimodal_support": true
    }
  },
  "tools": [
    {
      "name": "store_memory",
      "description": "Store new memory with cognitive features",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {"type": "string", "description": "Memory content"},
          "memory_type": {"type": "string", "enum": ["working", "episodic", "semantic", "procedural", "emotional"]},
          "metadata": {"type": "object", "description": "Additional metadata"},
          "modality": {"type": "string", "default": "text"},
          "emotional_valence": {"type": "number", "minimum": -1.0, "maximum": 1.0, "default": 0.0},
          "importance": {"type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.5}
        },
        "required": ["content", "memory_type"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "memory_id": {"type": "string"},
          "status": {"type": "string"},
          "memory_type": {"type": "string"},
          "embedding_generated": {"type": "boolean"},
          "timestamp": {"type": "number"}
        }
      }
    },
    {
      "name": "retrieve_memories",
      "description": "Retrieve memories with semantic similarity and pagination",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Search query"},
          "memory_types": {"type": "array", "items": {"type": "string"}, "description": "Memory types to search"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 5},
          "offset": {"type": "integer", "minimum": 0, "default": 0},
          "sort_by": {"type": "string", "enum": ["relevance", "timestamp", "importance"], "default": "relevance"}
        },
        "required": ["query"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "memories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "content": {"type": "string"},
                "memory_type": {"type": "string"},
                "timestamp": {"type": "number"},
                "importance": {"type": "number"},
                "relevance_score": {"type": "number"}
              }
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "offset": {"type": "integer"},
              "limit": {"type": "integer"},
              "total": {"type": "integer"},
              "has_more": {"type": "boolean"}
            }
          },
          "query": {"type": "string"},
          "sort_by": {"type": "string"}
        }
      }
    },
    {
      "name": "start_async_task",
      "description": "Start long-running async operation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_type": {"type": "string", "enum": ["bulk_memory_processing", "large_embedding_generation", "memory_consolidation"]},
          "task_data": {"type": "object", "description": "Task-specific data"}
        },
        "required": ["task_type", "task_data"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "task_id": {"type": "string"},
          "status": {"type": "string"},
          "created_at": {"type": "number"}
        }
      }
    },
    {
      "name": "get_task_status",
      "description": "Check status of async task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {"type": "string"}
        },
        "required": ["task_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "task_id": {"type": "string"},
          "status": {"type": "string", "enum": ["queued", "running", "completed", "failed"]},
          "progress": {"type": "number"},
          "result": {"type": "object"},
          "error": {"type": "string"},
          "created_at": {"type": "number"},
          "completed_at": {"type": "number"}
        }
      }
    },
    {
      "name": "process_with_attention",
      "description": "Process information with cognitive attention mechanism",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "context": {"type": "string"},
          "focus_type": {"type": "string", "enum": ["general", "analytical", "creative", "emotional"]}
        },
        "required": ["query"]
      }
    },
    {
      "name": "add_feedback",
      "description": "Add feedback for adaptive learning",
      "inputSchema": {
        "type": "object",
        "properties": {
          "interaction_id": {"type": "string"},
          "feedback_type": {"type": "string", "enum": ["positive", "negative", "correction"]},
          "score": {"type": "number", "minimum": -1.0, "maximum": 1.0}
        },
        "required": ["interaction_id", "feedback_type", "score"]
      }
    },
    {
      "name": "get_brain_status",
      "description": "Get comprehensive brain status and analytics",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "memory_count": {"type": "integer"},
          "memory_types": {"type": "object"},
          "cognitive_state": {"type": "object"},
          "performance_metrics": {"type": "object"},
          "system_info": {"type": "object"}
        }
      }
    }
  ],
  "transport": {
    "stdio": {
      "supported": true,
      "command": "python3",
      "args": ["brain_mcp_server.py"],
      "env": {
        "BRAIN_USE_SQLITE": "true",
        "BRAIN_LOG_LEVEL": "INFO"
      }
    },
    "http": {
      "supported": true,
      "host": "127.0.0.1",
      "port": 8080,
      "path": "/mcp",
      "env": {
        "MCP_TRANSPORT": "http",
        "BRAIN_USE_SQLITE": "true",
        "BRAIN_LOG_LEVEL": "INFO"
      }
    }
  },
  "security": {
    "oauth2": {
      "supported": true,
      "flows": ["client_credentials"],
      "scopes": ["brain:read", "brain:write"],
      "resource_indicators": true
    },
    "permissions": {
      "brain:read": "Read access to memories and cognitive state",
      "brain:write": "Write access to store memories and modify state"
    }
  },
  "tags": ["cognitive", "memory", "ai", "mcp", "brain", "learning", "embeddings", "sqlite"],
  "mcp_version": "2025.1",
  "api_version": "1.1.0"
}