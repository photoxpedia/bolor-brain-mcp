{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.photoxpedia/bolor-brain-mcp",
  "description": "Cognitive architecture MCP server with memory, learning, and contextual understanding",
  "repository": {
    "url": "https://github.com/photoxpedia/bolor-brain-mcp.git",
    "source": "github"
  },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "bolor-brain-mcp",
      "version": "1.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Enable SQLite storage (default: true)",
          "isRequired": false,
          "isSecret": false,
          "name": "BRAIN_USE_SQLITE"
        },
        {
          "description": "Log level (default: INFO)",
          "isRequired": false,
          "isSecret": false,
          "name": "BRAIN_LOG_LEVEL"
        }
      ]
    }
  ]
}